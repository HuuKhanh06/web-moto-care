VITE_APP_TITLE=MOTO CARE
VITE_APP_MODE=demo

# ==============================================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU ĐÁM MÂY SUPABASE (POSTGRESQL CLOUD)
# ==============================================================================
# Tạo project miễn phí tại https://supabase.com
# Lấy URL và anon public key tại Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# GIAI ĐOẠN 7: CẤU HÌNH TÍCH HỢP BÊN NGOÀI (EXTERNAL INTEGRATIONS)
# ==============================================================================
# Chế độ tích hợp: MOCK (chạy offline/mặc định) hoặc LIVE (gọi API thật)
VITE_INTEGRATION_MODE=MOCK

# --- B. VietQR Payment API (Chuẩn Napas 24/7) ---
# Mã BIN ngân hàng (Ví dụ: 970436 là Vietcombank, 970415 là VietinBank, 970422 là MB)
VITE_VIETQR_BANK_BIN=970436
VITE_VIETQR_ACCOUNT_NO=0123456789
VITE_VIETQR_ACCOUNT_NAME=CTY TNHH MOTO CARE
VITE_VIETQR_TEMPLATE=compact2

# --- A. EmailJS REST API (Gửi thông báo thật từ trình duyệt) ---
# Đăng ký miễn phí tại https://www.emailjs.com/
# Chú ý: Vì frontend-only, các khóa này công khai trong bundle. Chỉ dùng Public Key / Demo Account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- C. No-Code Workflow Webhook (n8n / Make / Zapier) ---
# Webhook URL nhận sự kiện BPMN từ MOTO CARE
VITE_WORKFLOW_WEBHOOK_URL=


# ==============================================================================
# GIAI ĐOẠN 8: CẤU HÌNH AI AGENT OCR (GOOGLE GEMINI API)
# ==============================================================================
# LOCAL: OCR thật trên thiết bị, không cần key (lần đầu tải dữ liệu eng/vie cần mạng).
# MOCK chỉ dành cho kịch bản thử nghiệm; LIVE gọi Google Gemini API.
VITE_AI_MODE=LOCAL

# Với web tĩnh, mọi biến VITE_* có mặt trong bundle. Ưu tiên nhập key cá nhân
# trong phiên Cấu hình AI; không đưa key production/private vào biến VITE_*.
# Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Mô hình Gemini sử dụng
VITE_GEMINI_MODEL=gemini-3.5-flash

# Online production: deploy document-ocr first, then set its public endpoint.
# Gemini production key belongs in Supabase secret GEMINI_API_KEY, never VITE_*.
# See docs/OCR_BACKEND_DEPLOY.md.
VITE_OCR_ENDPOINT=
